{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "fediscribe@netzgewitter.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/fediscribe-small.svg",
    "32": "icons/fediscribe-small.svg",
    "48": "icons/fediscribe.svg",
    "96": "icons/fediscribe.svg",
    "128": "icons/fediscribe.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/fediscribe-small.svg",
      "32": "icons/fediscribe-small.svg",
      "64": "icons/fediscribe.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
